{
  "worktree": {
    "setup": [
      "python3.12 -m venv .venv",
      ".venv/bin/python -m pip install -r requirements-validation.txt"
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "validate": {
      "command": ".venv/bin/python scripts/validate_plan.py"
    }
  }
}
