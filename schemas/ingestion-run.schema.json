{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/synthetic-ingestion-run-0.1",
  "title": "Synthetic offline job snapshot proposal (not production acceptance)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "evidence_level", "rights_cleared", "publication_eligible", "id", "run_id", "source_id", "request_id", "request_digest", "decision_digest", "parser_version", "state", "attempts", "checkpoint", "observations", "receipts"],
  "properties": {
    "schema_version": {"const": "synthetic-ingestion-run-0.1"},
    "synthetic": {"const": true},
    "evidence_level": {"const": "synthetic_unverified"},
    "rights_cleared": {"const": false},
    "publication_eligible": {"const": false},
    "id": {"$ref": "#/$defs/digest"},
    "run_id": {"$ref": "#/$defs/identity"},
    "source_id": {"$ref": "#/$defs/identity"},
    "request_id": {"$ref": "#/$defs/identity"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "decision_digest": {"$ref": "#/$defs/digest"},
    "parser_version": {"type": "string", "maxLength": 80, "not": {"pattern": "[\\r\\n]"}, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "state": {"enum": ["ready", "retry", "done", "dead", "cancelled"]},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 8},
    "checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
    "observations": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "logical_id", "digest"],
        "properties": {"id": {"$ref": "#/$defs/digest"}, "logical_id": {"$ref": "#/$defs/identity"}, "digest": {"$ref": "#/$defs/digest"}}
      }
    },
    "receipts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["state", "reason", "attempt", "at"],
        "properties": {
          "state": {"enum": ["ready", "retry", "done", "dead", "cancelled", "refused"]},
          "reason": {"enum": ["admitted", "accepted", "terminal", "operator_cancelled", "missing_decision", "scope_mismatch", "field_mismatch", "permission_not_unconditional", "decision_inactive", "invalid_policy_envelope", "request_changed", "decision_changed", "decision_revision_conflict", "quota_exhausted", "completion_conflict", "observation_conflict", "timeout", "unavailable", "rate_limited", "attempts_exhausted", "parse_failed", "validation_failed"]},
          "attempt": {"type": "integer", "minimum": 0, "maximum": 8},
          "at": {"type": "integer", "description": "Synthetic caller clock, epoch microseconds; not an authenticated timestamp."}
        }
      }
    }
  },
  "$defs": {
    "identity": {"type": "string", "maxLength": 256, "not": {"pattern": "[\\r\\n]"}, "pattern": "^urn:pya:synthetic:[a-z0-9][a-z0-9:._-]*$"},
    "digest": {"type": "string", "maxLength": 64, "pattern": "^[a-f0-9]{64}$"}
  }
}
