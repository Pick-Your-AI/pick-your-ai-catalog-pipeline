{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog pipeline coverage baseline",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "parent_issue",
    "measurement_policy",
    "requirements",
    "domains",
    "consumer_contracts"
  ],
  "properties": {
    "schema_version": {
      "const": "catalog-pipeline-coverage-1"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "parent_issue": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "measurement_policy": {
      "type": "object",
      "required": [
        "candidate_count",
        "deduplicated_entity_count",
        "sourced_count",
        "reviewed_count",
        "independently_measured_count",
        "publication_eligible_count",
        "published_count",
        "unknown_meaning",
        "dimensions",
        "non_claim"
      ],
      "properties": {
        "candidate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "deduplicated_entity_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sourced_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reviewed_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "independently_measured_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "publication_eligible_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "published_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unknown_meaning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "non_claim": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "coverage_intent",
          "work_packages",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "coverage_intent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "work_packages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CP-\\d{2,}\\.\\d{2,}$"
            }
          },
          "state": {
            "enum": [
              "Planned",
              "In Progress",
              "Accepted",
              "Deferred"
            ]
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "title",
          "boundary",
          "work_packages",
          "inclusion_rule",
          "exclusion_rule",
          "research_authority",
          "consumer_boundary",
          "measurement",
          "state"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "work_packages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CP-\\d{2,}\\.\\d{2,}$"
            }
          },
          "inclusion_rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "exclusion_rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "research_authority": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "consumer_boundary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "measurement": {
            "type": "object",
            "required": [
              "candidate",
              "normalized",
              "reviewed",
              "eligible",
              "published"
            ],
            "properties": {
              "candidate": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "normalized": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reviewed": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "eligible": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "published": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "state": {
            "enum": [
              "Planned",
              "In Progress",
              "Measured",
              "Published",
              "Restricted",
              "Deferred"
            ]
          }
        }
      }
    },
    "consumer_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "work_packages",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "work_packages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CP-\\d{2,}\\.\\d{2,}$"
            }
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
